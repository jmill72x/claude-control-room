#!/usr/bin/env node
// Approve a pairing code for the chat from this machine (jarvis-os-chat-spec.md,
// §2.2): the first device, when no paired device exists to approve from.
//
//   bin/chat-pair <CODE>                      approve the code the new device shows
//   bin/chat-pair --devices                   list the paired devices
//   bin/chat-pair approver <device> on|off    mark a device as one that may Allow
//                                             a permission (by its name or id); every
//                                             change is alerted, and a revoke clears it
//   bin/chat-pair shortcut-code <name>        make the one-time code for a new Shortcut
//                                             key of that name (the Setup Shortcut asks
//                                             for it; the key sends messages, and reads
//                                             or approves nothing). The name is plain
//                                             letters and digits, 22 at most. Refused
//                                             while the kill file exists
//                                             (~/.local/state/jarvis-os/shortcuts-off)
//   bin/chat-pair passkey <CODE>              confirm the Face ID passkey an approver
//                                             device just made for stops (the page
//                                             shows the code; 10 minutes, 3 tries).
//                                             Only at a terminal: it refuses without
//                                             a TTY, shows the device and when it was
//                                             set up, and asks for the device's name
//                                             typed back (any process of this user
//                                             can reach the admin socket, so a person
//                                             must read what is confirmed)
//   bin/chat-pair shortcuts                   list the Shortcut keys
//   bin/chat-pair shortcut-revoke <key>       revoke a Shortcut key, by its name or id
//
// Talks to the Control Room over its admin socket (JARVIS_OS_ADMIN_SOCKET, default
// ~/.local/state/jarvis-os/admin.sock, 0600). Exit 0 on success, 1 on a refusal, 2
// on a usage or connection problem.
import { request } from 'node:http';
import { homedir } from 'node:os';
import { join } from 'node:path';

const socketPath = process.env.JARVIS_OS_ADMIN_SOCKET || join(homedir(), '.local', 'state', 'jarvis-os', 'admin.sock');
const arg = process.argv[2];
if (!arg || arg === '-h' || arg === '--help') {
  console.error('usage: chat-pair <CODE> | --devices | approver <device> on|off | passkey <CODE> | shortcut-code <name> | shortcuts | shortcut-revoke <key>');
  process.exit(2);
}
if ((arg === 'shortcut-code' || arg === 'shortcut-revoke') && process.argv.length !== 4) {
  console.error(arg === 'shortcut-code' ? 'usage: chat-pair shortcut-code <name for the key>' : 'usage: chat-pair shortcut-revoke <key name or id>');
  process.exit(2);
}
if (arg === 'passkey' && process.argv.length !== 4) {
  console.error('usage: chat-pair passkey <CODE the page shows>');
  process.exit(2);
}
if (arg === 'passkey' && !(process.stdin.isTTY && process.stdout.isTTY)) {
  console.error('chat-pair passkey runs only at a terminal (an interactive TTY): Jeff types it himself, never a script or an agent');
  process.exit(2);
}
if (arg === 'approver' && (process.argv.length !== 5 || !['on', 'off'].includes(process.argv[4]))) {
  console.error('usage: chat-pair approver <device name or id> on|off');
  process.exit(2);
}

const call = (method, path, body) => new Promise((resolve, reject) => {
  const req = request({ socketPath, method, path, headers: body ? { 'Content-Type': 'application/json' } : {}, timeout: 5000 }, res => {
    let raw = '';
    res.setEncoding('utf8');
    res.on('data', c => { raw += c; });
    res.on('end', () => { let parsed = null; try { parsed = JSON.parse(raw); } catch { parsed = { error: raw.slice(0, 200) }; } resolve({ status: res.statusCode, body: parsed }); });
  });
  req.on('timeout', () => req.destroy(new Error('timed out')));
  req.on('error', reject);
  if (body) req.write(JSON.stringify(body));
  req.end();
});

try {
  if (arg === '--devices') {
    const { status, body } = await call('GET', '/admin/devices');
    if (status !== 200) { console.error(body.error ?? `HTTP ${status}`); process.exit(1); }
    for (const d of body.devices) console.log(`${d.id}  ${d.name}${d.revokedAt ? '  (revoked)' : ''}${d.approver ? '  (approver)' : ''}  paired ${new Date(d.createdAt).toISOString()}  seen ${d.lastSeenAt ? new Date(d.lastSeenAt).toISOString() : 'never'}`);
    if (body.devices.length === 0) console.log('no devices');
    if (body.pending) console.log('a pairing is pending: chat-pair <CODE> approves it');
  } else if (arg === 'shortcuts') {
    const { status, body } = await call('GET', '/admin/shortcuts');
    if (status !== 200) { console.error(status === 404 ? 'Shortcut keys are off on this server (config chat.shortcuts)' : body.error ?? `HTTP ${status}`); process.exit(1); }
    // A key unused for 30 days expires (server/lib/shortcut-keys.mjs): a live key's line ends
    // with when. A revoked key comes with no `expiresAt`.
    const iso = at => (Number.isFinite(at) ? new Date(at).toISOString() : 'unknown');
    for (const k of body.keys) console.log(`${k.id}  ${k.name}${k.revokedAt ? '  (revoked)' : k.expired ? '  (expired)' : ''}  made ${iso(k.createdAt)}  used ${k.lastUsedAt ? iso(k.lastUsedAt) : 'never'}  ${k.uses} use${k.uses === 1 ? '' : 's'}${k.expired || !Number.isFinite(k.expiresAt) ? '' : `  expires ${iso(k.expiresAt)} if unused`}`);
    if (body.keys.length === 0) console.log('no Shortcut keys');
    if (body.waiting) console.log(`a code is waiting for its Shortcut (${body.waiting.name}) until ${new Date(body.waiting.expiresAt).toISOString()}`);
  } else if (arg === 'shortcut-code') {
    const { status, body } = await call('POST', '/admin/shortcut/code', { name: process.argv[3] });
    if (status !== 200) { console.error(status === 404 && body.error === 'not found' ? 'Shortcut keys are off on this server (config chat.shortcuts)' : body.error ?? `HTTP ${status}`); process.exit(1); }
    console.log(`${body.code}  the code for the Shortcut key ${body.name}: enter it in the Setup Shortcut within 10 minutes`);
  } else if (arg === 'shortcut-revoke') {
    const { status, body } = await call('POST', '/admin/shortcut/revoke', { key: process.argv[3] });
    if (status !== 200) { console.error(status === 404 && body.error === 'not found' ? 'Shortcut keys are off on this server (config chat.shortcuts)' : body.error ?? `HTTP ${status}`); process.exit(1); }
    console.log(`revoked: the Shortcut key ${body.key.name}`);
  } else if (arg === 'passkey') {
    const seen = await call('GET', '/admin/passkey');
    if (seen.status !== 200) { console.error(seen.status === 404 ? 'this server has no Face ID for stops (an older build)' : seen.body.error ?? `HTTP ${seen.status}`); process.exit(1); }
    const p = seen.body.pending;
    if (!p) { console.error('no Face ID set-up is waiting'); process.exit(1); }
    console.log(`Face ID set-up waiting: device "${String(p.name).replace(/[\u0000-\u001f\u007f-\u009f]/g, ' ')}", made ${new Date(p.at).toISOString()}, expires ${new Date(p.expiresAt).toISOString()}`);
    const { createInterface } = await import('node:readline/promises');
    const rl = createInterface({ input: process.stdin, output: process.stdout });
    const typed = await rl.question('Type that device name to confirm (anything else cancels): ');
    rl.close();
    const { status, body } = await call('POST', '/admin/passkey', { code: String(process.argv[3]).trim().toUpperCase(), name: typed });
    if (status !== 200) { console.error(status === 404 && body.error === 'not found' ? 'this server has no Face ID for stops (an older build)' : body.error ?? `HTTP ${status}`); process.exit(1); }
    console.log(`confirmed: ${body.name} can now stop the lead's background agents with Face ID`);
  } else if (arg === 'approver') {
    const on = process.argv[4] === 'on';
    const { status, body } = await call('POST', '/admin/approver', { device: process.argv[3], on });
    if (status !== 200) { console.error(body.error ?? `HTTP ${status}`); process.exit(1); }
    console.log(`${body.device.name}: ${on ? 'may now allow permissions' : 'may no longer allow permissions'}${body.changed ? '' : ' (unchanged)'}`);
  } else {
    const { status, body } = await call('POST', '/admin/approve', { code: String(arg).trim().toUpperCase() });
    if (status !== 200) { console.error(body.error ?? `HTTP ${status}`); process.exit(1); }
    console.log(`approved: ${body.name} can now collect its cookie (the page's pairing screen does that)`);
  }
} catch (err) {
  console.error(`chat-pair: could not reach the Control Room's admin socket (${err.message})`);
  process.exit(2);
}
